{
    "name": "nikola/buy-a-cow",
    "description": "Small vanilla PHP 8.1 user activity tracking system",
    "type": "project",
    "require": {
        "php": "~8.1.34"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs"
    }
}
